generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
}

model LineUser {
  id            String    @id @default(cuid())
  lineUserId    String    @unique @map("line_user_id")
  displayName   String?   @map("display_name")
  pictureUrl    String?   @map("picture_url")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  messages      Message[]

  @@index([lastMessageAt])
  @@map("line_users")
}

model Message {
  id             String           @id @default(cuid())
  lineMessageId  String?          @unique @map("line_message_id")
  webhookEventId String?          @unique @map("webhook_event_id")
  contactId      String           @map("contact_id")
  direction      MessageDirection
  status         MessageStatus
  text           String
  errorMessage   String?          @map("error_message")
  occurredAt     DateTime         @map("occurred_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  contact        LineUser         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
  @@map("messages")
}
